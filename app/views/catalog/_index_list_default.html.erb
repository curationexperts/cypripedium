<div class="col-sm-9">
  <dl class="metadata">
    <% document_presenter(document).fields_to_render.each do |field_name, field, field_presenter| -%>
      <div class="row align-items-baseline border-top py-2 <%= "attribute #{field.itemprop}" -%>">
        <dt class="col-auto"><span class="attribute-label h4"><%= field_presenter.label %>:</span></dt>
        <dd class="col"><%= field_presenter.render %></dd>
      </div>
    <% end %>
  </dl>
</div>
