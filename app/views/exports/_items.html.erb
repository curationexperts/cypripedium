<div class="heading-row">
  <h3>Export ID: <%= export.id %></h3>
  <div class="visibility"><%= visibility_badge(export.visibility) -%></div>
</div>
<div class="heading-row">
  <div class="export-status">
    <span class="status <%= export.status %>"><%= export.status.capitalize -%></span>
    <span class="updated_at"><%= export.updated_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
    <% if export.export_file.attached? && export.error_count.positive? %>
      <span class="error_count"><%= pluralize(export.error_count, 'error') -%></span>
    <% end %>
  </div>
  <div class="item-counts">
    <% if export.missing_items? %>
      <span class="exported_count"><%= export.exported_count -%></span>
    <% end %>
    <span class="item_count"><%= pluralize(export.items.count, 'item') -%></span>
  </div>
</div>
<div>
  <span class="format"><%= export.format -%></span>
  <% if export.export_file.attached? %>
    <%= link_to(export.export_file.filename, export_download_path(export, locale: nil), download: export.export_file.filename, class: 'download-link') -%>
  <% end %>
</div>

<ul class="item-list">
  <% docs.each do |doc| %>
    <% item_link = work_path(doc) %>
    <li class="export-item" id="<%= dom_id(doc) %>">
      <span class="id"><%= link_to_if item_link, doc.id, item_link, target: '_blank', rel: 'noopener noreferrer' %></span>
      <span class="title"><%= doc.title.first || content_tag(:em, "Item not available") %></span>
    </li>
  <% end %>
</ul>

<% if export.message.present? %>
  <div id="export-message">
    <h4 class="status <%= export.status %>" ><%= export.status.capitalize %></h4>
    <pre><%= export.message %></pre>
  </div>
<% end %>
